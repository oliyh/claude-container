# Set these in Coolify (Environment Variables) or in a local .env

# Your Google account email — the only identity let through the login.
ALLOWED_EMAIL=oliy@oliy.co.uk

# Google OAuth client (https://console.cloud.google.com/apis/credentials,
# type "Web application"). Authorised redirect URI: ${PUBLIC_URL}/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random characters:  openssl rand -hex 16
COOKIE_SECRET=

# Public URL Coolify serves the auth-proxy on, no trailing slash
PUBLIC_URL=https://claude.example.com

# Optional, fine-grained PAT with Contents: read/write (clone private repos, push)
GITHUB_TOKEN=
# Owner assumed when you type a bare repo name
GITHUB_OWNER=oliyh
# Comma-separated owners the UI may clone from (default: just GITHUB_OWNER)
ALLOWED_OWNERS=
# Optional limits per session container
SESSION_MEMORY=
SESSION_CPUS=
